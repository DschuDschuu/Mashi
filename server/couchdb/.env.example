# MANUELLE VARIANTE ohne Coolify. Für Coolify: ../coolify/ANLEITUNG.md (dort keine .env nötig).
# Kopieren nach .env und ausfüllen. Die .env gehört NICHT ins Git-Repo.

# Subdomain, unter der die Datenbank erreichbar ist.
# Vorher per DNS (A-Record) auf die Server-IP zeigen lassen.
MASHI_DB_HOST=mashi-db.carapaxo.de

# CouchDB-Administrator – nur für die Einrichtung und Wartung.
# Kommt NIE in die Mashi-App. Langes, zufälliges Passwort verwenden.
# Eigenen, nicht erratbaren Namen wählen – NICHT „admin“ (das wird als Erstes durchprobiert).
COUCHDB_ADMIN_USER=
COUCHDB_ADMIN_PASSWORD=

# ── KI-Rezepte (optional, siehe ANLEITUNG.md „KI einrichten“) ──────────────────────────
# Schlüssel von https://openrouter.ai (Konto → Keys). Bleibt NUR hier auf dem Server.
OPENROUTER_API_KEY=
# Modell von https://openrouter.ai/models – für kostenlos nach „free“ filtern (Name endet auf :free).
OPENROUTER_MODEL=
# Woher die App kommt (GitHub Pages). Mehrere mit Komma.
KI_ALLOWED_ORIGINS=https://dschudschuu.github.io
# Rezepte je Person (schützt das Gratis-Kontingent)
KI_PER_HOUR=20
KI_PER_DAY=60
